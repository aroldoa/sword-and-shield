---
// Fades elements up as they scroll into view. See `.reveal` in global.css.
---

<script>
  const root = document.documentElement;
  const STAGGER_MS = 90;
  const MAX_STEPS = 6; // cap so long grids don't make the last item wait seconds

  const targets: HTMLElement[] = [];
  document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => targets.push(el));
  document.querySelectorAll<HTMLElement>('.reveal-stagger').forEach((parent) => {
    [...parent.children].forEach((child, i) => {
      const el = child as HTMLElement;
      el.style.setProperty('--reveal-delay', `${Math.min(i, MAX_STEPS) * STAGGER_MS}ms`);
      targets.push(el);
    });
  });

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (targets.length && !reduce && 'IntersectionObserver' in window) {
    const reveal = (el: HTMLElement) => el.classList.add('is-revealed');

    // Anything already on screen at load shows right away (no flash of hidden content).
    const vh = window.innerHeight;
    const pending = targets.filter((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < vh * 0.92 && r.bottom > 0) {
        reveal(el);
        return false;
      }
      return true;
    });

    root.classList.add('reveal-ready');

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    pending.forEach((el) => io.observe(el));
  }
</script>
