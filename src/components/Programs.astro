---
import { IMG, PROGRAMS } from '../data/site';
import { img, srcset } from '../lib/img';
---

<section id="membership" class="relative overflow-hidden bg-neutral-950 min-h-[70vh] sm:min-h-[85vh] flex flex-col justify-center py-12 sm:py-20 md:py-28 lg:py-36">
  <img
    src={img(IMG.membershipBg, 1440, { height: 600 })}
    srcset={`${img(IMG.membershipBg, 800, { height: 333 })} 800w, ${img(IMG.membershipBg, 1440, { height: 600 })} 1440w`}
    sizes="100vw"
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-0 z-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 z-[1] pointer-events-none bg-brand-950/[0.88]" aria-hidden="true"></div>
  <div class="absolute right-0 top-1/4 w-1/2 h-1/2 bg-linear-to-b from-brand-900/10 to-transparent blur-[100px] z-0"></div>

  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 relative z-10">
    <div class="mb-10 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-medium uppercase tracking-tighter leading-none mb-4">
        One Membership. <br /> <span class="text-brand-600">Total Impact.</span>
      </h2>
      <p class="text-base sm:text-xl text-neutral-400 max-w-2xl">
        Sword &amp; Shield is Cornerstone Christian Schools' unified support program that funds excellence across all student activities. Your membership directly supports:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {
        PROGRAMS.map((p) => (
          <div class="group relative rounded-2xl sm:rounded-3xl border border-neutral-800 overflow-hidden aspect-[4/3] sm:aspect-auto sm:min-h-[480px] lg:min-h-[620px] flex flex-col justify-end items-center p-4 sm:p-8 text-center transition-all duration-500 hover:border-brand-600/70 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(185,28,28,0.45)] motion-reduce:hover:translate-y-0">
            {/* Photo: slow zoom + brighten */}
            <img
              src={img(p.image, 640)}
              srcset={srcset(p.image, [400, 640, 960])}
              sizes="(min-width: 1024px) 24vw, (min-width: 640px) 48vw, 92vw"
              alt=""
              loading="lazy"
              decoding="async"
              style={`object-position: ${p.position};`}
              class="absolute inset-0 z-0 w-full h-full object-cover transition duration-700 ease-out group-hover:scale-110 group-hover:brightness-110 motion-reduce:group-hover:scale-100"
            />
            {/* Base darkening */}
            <div class="absolute inset-0 z-[1] bg-linear-to-t from-neutral-950/95 via-neutral-950/60 to-transparent transition-opacity duration-500 group-hover:opacity-80" />
            {/* Red wash rising from the bottom */}
            <div class="absolute inset-0 z-[1] bg-linear-to-t from-brand-900/70 via-brand-600/15 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

            <div class="relative z-10 transition-transform duration-500 group-hover:-translate-y-2 motion-reduce:group-hover:translate-y-0">
              <h3 class="font-display text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-white uppercase tracking-tight mb-1 sm:mb-3">{p.title}</h3>
              <span class="block mx-auto h-0.5 w-8 bg-brand-500 mb-2 sm:mb-3 transition-all duration-500 group-hover:w-20" aria-hidden="true" />
              <p class="text-neutral-300 text-xs sm:text-sm leading-relaxed transition-colors duration-500 group-hover:text-white">{p.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 sm:mt-10 p-4 sm:p-6 rounded-2xl bg-black/45 border border-brand-600">
      <p class="text-base sm:text-lg text-white">
        <span class="font-semibold">Every membership dollar</span> goes directly to student programs, equipment, and opportunities.
      </p>
    </div>
  </div>
</section>
